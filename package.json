{
  "name": "infoface",
  "author": "Florian Klug-Göri",
  "version": "0.9.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.0.10"
  },
  "pebble": {
    "displayName": "Infoface",
    "uuid": "8047c3ec-ee69-418d-b0f1-3da7371aee63",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "ItemCount",
      "ItemPrefix",
      "ItemText",
      "ItemIndex",
      "ShowBattery",
      "ShowQuietTime",
      "ShowBluetooth",
      "ServerUrl",
      "ItemType",
      "TapAxisX",
      "TapAxisY",
      "TapAxisZ",
      "TapThresholdMg",
      "TapRingdownMs",
      "TapMultiTapWindowMs",
      "EnablePagination",
      "PanelCount",
      "PanelIndex",
      "PanelTitle",
      "EnableAccelTaps",
      "PanelRotationEvent",
      "PageRotationEvent"
    ],
    "resources": {
      "media": []
    },
    "companionApp": {
      "android": {
        "url": "https://github.com/flurl/infoface-companion/releases/latest",
        "apps": [
          {
            "package": "family.dieflomis.infocompanion"
          }
        ]
      }
    }
  }
}
